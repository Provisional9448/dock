# Copy to .env and fill in locally. Never commit .env.
# Dock does not read this file automatically. Export the variables yourself.

# Guava voice (https://goguava.ai/docs). Required only for a live call.
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=
# Separate inbound listener gate. Keep outbound/SMS disabled for this sprint.
DOCK_INBOUND_MODE=dry-run

# Live dial and live SMS are off unless you set these. The Saturday demo
# does not need them. The Twilio and Guava SMS adapters in this starter
# do not transmit even if the variables are set.
DOCK_CALL_MODE=dry-run
DOCK_SMS_MODE=dry-run

# log | twilio | guava
# The web desk always uses the log provider. This variable is for the CLI.
SMS_PROVIDER=log

# Twilio stub. Unused by the log provider. Not read to send traffic.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100

# Sample detention policy. The curated load has the same numbers in
# data/samples/parties.json. CLI flags override these.
DOCK_FREE_MINUTES=120
DOCK_WARN_MINUTES=30
DOCK_RATE_USD_PER_HOUR=75.00
DOCK_INCREMENT_MINUTES=15
DOCK_LOG=data/samples/harbor-rye.raw.jsonl
